   "op": "pql_score",
   "label": "PQL score",
   "help": "Score each account: usage points (capped per feature) \u00d7 fit multipliers. Accounts above the threshold alert an AE.",
   "input": {
    "pql_threshold": 60,
    "usage_model": [
