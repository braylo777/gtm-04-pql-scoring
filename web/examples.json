      "max_points": 30
     },
     {
      "feature": "reports_shared",
      "points_per_unit": 2,
      "max_points": 20
     }
    ],
    "fit_model": [
     {
      "field": "employees",
      "min": 100,
      "max": 5000,
      "multiplier_if_true": 1.2,
      "multiplier_if_false": 0.6
